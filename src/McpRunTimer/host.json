{
  "version": "2.0",
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      },
      "enableLiveMetricsFilters": true
    }
  },
  "extensions": {
    "mcp": {
      "serverName": "Run Timer MCP Server",
      "serverVersion": "1.0.0",
      "instructions": "This is a Run Timer MCP server that allows you to track run times. Use the start_run, get_elapsed, and stop_run tools to track your run.",
      "system": {
        "webhookAuthorizationLevel": "Anonymous"
      }
    }
  }
}
