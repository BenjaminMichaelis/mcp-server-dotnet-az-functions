{
  "mcpServers": {
    "remote-functions-mcp-tool": {
      "type": "http",
      "url": "https://${input:functionapp-name}.azurewebsites.net/runtime/webhooks/mcp"
    },
    "remote-mcp-weather-app": {
      "type": "http",
      "url": "https://${input:functionapp-name}.azurewebsites.net/runtime/webhooks/mcp",
      "headers": {
        "x-functions-key": "${input:functions-mcp-extension-system-key}"
      }
    },
    "local-mcp-function": {
      "type": "http",
      "url": "http://localhost:7071/runtime/webhooks/mcp"
    },
    "local-mcp-showcase": {
      "type": "http",
      "url": "http://localhost:7071/runtime/webhooks/mcp"
    },
    "local-mcp-run-timer": {
      "type": "http",
      "url": "http://localhost:63007/runtime/webhooks/mcp"
    },
    "aspire": {
      "type": "stdio",
      "command": "aspire",
      "args": [
        "agent",
        "mcp"
      ]
    },
    "essentialcsharp": {
      "url": "https://essentialcsharp.com/mcp",
      "type": "http",
      "headers": {
        "Authorization": "Bearer ${input:essentialcsharp-token}"
      }
    }
  },
  "inputs": [
    {
      "type": "promptString",
      "id": "essentialcsharp-token",
      "description": "Essential C# MCP Bearer Token",
      "password": true
    }
  ]
}