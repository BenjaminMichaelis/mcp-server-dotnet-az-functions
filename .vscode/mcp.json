{
  "servers": {
    "local-mcp-run-timer": {
      "type": "http",
      "url": "http://localhost:63007/runtime/webhooks/mcp"
    },
    "remote-mcp-run-timer": {
      "type": "http",
      "url": "https://mcp-run-timer.whitedune-251ef1e3.westus3.azurecontainerapps.io/runtime/webhooks/mcp",
      "headers": {
        "x-functions-key": "${input:functions-mcp-extension-system-key}"
      }
    },
    "local-mcp-showcase": {
      "type": "http",
      "url": "http://localhost:7072/runtime/webhooks/mcp"
    },
    "aspire": {
      "type": "stdio",
      "command": "aspire",
      "args": [
        "agent",
        "mcp"
      ]
    }
  },
  "inputs": [
    {
      "type": "promptString",
      "id": "functions-mcp-extension-system-key",
      "description": "Azure Functions MCP Extension System Key",
      "password": true
    },
    {
      "type": "promptString",
      "id": "functionapp-name",
      "description": "Azure Functions App Name (e.g. func-timer-abc123)"
    }
  ]
}